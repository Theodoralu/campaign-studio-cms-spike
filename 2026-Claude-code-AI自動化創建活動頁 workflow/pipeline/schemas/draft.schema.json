  "products": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "gdid": {
      "type": "string",
      "readOnly": true,
      "x-permission": "🔒",
      "description": "🔒 商品編號（uther productId）"
     },
     "position": {
      "type": "string",
      "pattern": "^(kv(-main|-sub[12])?|featured-[1-3](-scene)?|category-[1-5]|wall-[1-5]|editorial-wall)$"
     },
     "order": {
      "type": "integer"
     },
     "name": {
      "type": "string",
      "readOnly": true,
      "x-permission": "🔒",
      "description": "🔒 品名（uther title）"
     },
     "price": {
      "type": "integer",
      "readOnly": true,
      "x-permission": "🔒",
      "description": "🔒 實付價＝uther currentPrice ?? marketPrice；存檔時照伺服器（14 號 §2.15）"
     },
     "url": {
      "type": "string",
      "readOnly": true,
      "x-permission": "🔒",
      "description": "🔒 商品頁（uther productURL）",
      "pattern": "^https://(tw\\.buy\\.yahoo\\.com|img\\.yec\\.tw|s\\.yimg\\.com)/"
     },
     "img": {
      "type": "string",
      "pattern": "^https://(tw\\.buy\\.yahoo\\.com|img\\.yec\\.tw|s\\.yimg\\.com)/"
     },
     "sceneImg": {
      "type": "string"
     },
     "offer": {
      "type": [
       "null",
       "string"
      ]
     },
     "tag": {
      "type": "string",
      "x-permission": "✍️（manual 時）"
     },
     "tagSource": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "offer",
       "feature",
       "manual",
       null
      ]
     },
     "tagOriginal": {
      "type": [
       "null",
       "string"
      ]
     },
     "marketPrice": {
      "type": [
       "integer",
       "null"
      ],
      "readOnly": true,
      "x-permission": "🔒",
      "description": "🔒 劃線價＝有 currentPrice 時的 uther marketPrice；契約範例寫 listPrice"
     },
     "kvShortName": {
      "type": [
       "null",
       "string"
