{
 "type": "object",
 "properties": {
  "page": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}-wb-\\d{6}$",
     "description": "run id，建立時由日期時間產生，之後不變（S3 prefix）"
    },
    "pageName": {
     "type": "string",
     "description": "A2 管理名；契約寫 name，程式用 pageName"
    },
    "status": {
     "type": "string",
     "enum": [
      "草稿",
      "調修中",
      "待建置",
      "已建置"
     ]
    },
    "template": {
     "type": "string",
     "enum": [
      "MVP-v1"
     ]
    },
    "inputTier": {
     "type": "string",
