         "title": {
          "type": "string"
         },
         "sub": {
          "type": "string"
         }
        },
        "additionalProperties": true
       },
       "productGdids": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "契約名 productRefs；程式落地形 productGdids。每層 3～15 件（gate ZONE_PRODUCT_RANGE.floors，3/7/11/15 節奏）",
        "minItems": 3,
        "maxItems": 15
       },
       "sceneImg": {
        "type": "string"
       },
       "sceneUrl": {
        "type": "string",
        "readOnly": true,
        "x-permission": "🔒",
        "description": "🔒 代表品商品頁；全頁唯一（U12）"
       },
       "moreLink": {
        "type": "object",
        "properties": {
         "enabled": {
          "type": "string",
          "enum": [
           "on",
           "off"
          ]
         },
         "url": {
          "type": "string"
         }
        },
        "additionalProperties": true
       }
      },
      "additionalProperties": true,
      "required": [
       "pos",
       "title",
       "productGdids"
      ]
     },
     "minItems": 1,
     "maxItems": 3
    },
    "walls": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "pos": {
        "type": "string",
        "pattern": "^(category|wall)-[1-5]$",
        "description": "現行引擎產 category-N；舊檔 wall-N（2026-08 大體檢前）仍要讀得懂"
       },
       "title": {
        "type": "string"
       },
       "titleSource": {
        "type": "string"
       },
       "productGdids": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "每牆 4～12 件；{4,8,12} 最整齊，非倍數＝WARN 不擋（2026-10-05 裁）",
        "minItems": 4,
        "maxItems": 12
       },
       "moreLink": {
        "type": "object",
        "properties": {
         "enabled": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "additionalProperties": true
       },
       "wallProductCount": {
        "type": "string"
       }
      },
      "additionalProperties": true,
      "required": [
       "pos",
       "title",
       "productGdids"
      ]
     },
     "minItems": 1,
     "maxItems": 3,
     "description": "品類牆 1～3 面（gate CATEGORY_WALL_COUNT，2026-08-27 裁決；契約 14 號快照仍寫 3～5）"
    },
    "categoryWallCount": {
     "type": [
      "integer",
      "string"
     ],
     "deprecated": true,
     "description": "[deprecated 2026-11-05 裁] 由 walls.length 推，寫入端不再產生；舊檔仍可能帶（整數或數字字串），讀入忽略"
    },
    "editorial": {
     "type": "object",
     "properties": {
      "title": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "契約寫 {line1,line2,tagline} 物件；程式落地形為三行字串陣列"
