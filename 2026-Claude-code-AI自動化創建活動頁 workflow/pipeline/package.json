  "scripts": {
    "check": "bash dod-check.sh static",
    "check:full": "bash dod-check.sh full",
    "guard": "node tools/dod-guards.js",
    "test": "node tools/dod-guards.js && (find test -name '*.test.js' 2>/dev/null | grep -q . && node --test || echo 'ⓘ 尚無 test/（Phase 2 補）')",
    "test:unit": "node --test test/unit/*.test.js",
    "selftest": "bash dod-check.sh full",
    "gates": "bash dod-check.sh full",
    "design:qa": "node tools/design_qa.js",
    "schema:check": "node tools/schema/validate.js schemas test/fixtures/gate_pass_draft.json test/fixtures/gate_fail_draft.json test/fixtures/gate_pass_layout006_draft.json test/fixtures/gate_pass_snapshot.json",
    "schema:run": "node tools/schema/validate.js schemas",
    "test:replay": "node --test test/unit/snapshot_replay.test.js test/unit/clock_http_replay.test.js",
    "cassette:from-raw": "node tools/cassette_from_raw.js"
  },
