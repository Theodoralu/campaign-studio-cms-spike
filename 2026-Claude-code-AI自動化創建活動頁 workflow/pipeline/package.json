{
  "name": "pipeline",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "check": "bash dod-check.sh static",
    "check:full": "bash dod-check.sh full",
    "guard": "node tools/dod-guards.js",
    "test": "node --test --test-timeout=120000 \"test/*.test.js\" \"test/unit/*.test.js\"",
    "test:unit": "node --test --test-timeout=120000 \"test/unit/*.test.js\"",
    "selftest": "bash dod-check.sh full",
    "gates": "bash dod-check.sh full",
    "design:qa": "node tools/design_qa.js",
    "schema:check": "node tools/schema/validate.js schemas test/fixtures/gate_pass_draft.json test/fixtures/gate_fail_draft.json test/fixtures/gate_pass_layout006_draft.json test/fixtures/gate_pass_snapshot.json",
    "schema:run": "node tools/schema/validate.js schemas",
    "test:replay": "node --test test/unit/snapshot_replay.test.js test/unit/clock_http_replay.test.js",
    "cassette:from-raw": "node tools/cassette_from_raw.js",
    "test:legacy-env": "node --test \"test/legacy-env/*.test.js\"",
    "test:phase2": "node --test \"test/phase2/*.test.js\"",
    "ci": "npm run secret:scan && npm run schema:check && npm run test:replay && npm run test:golden && npm test",
    "test:golden": "node --test test/e2e_golden.test.js",
    "golden:regen": "bash tools/golden_regen.sh",
    "secret:scan": "node tools/secret_scan.js",
    "test:uther": "node --test test/unit/uther_client.test.js test/unit/source_build_snapshot.test.js test/unit/uther_replay.test.js",
    "snapshot:diff": "node tools/snapshot_diff.js",
    "uther:probe": "node tools/uther_probe.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
